# Prisma Postgres (or any Postgres) connection string.
DATABASE_URL=""

# Signs session cookies. Generate your own with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-base64-string"

# Seed credentials for the first manager account (used by `npm run db:seed`).
MANAGER_EMAIL="marcs@beldenae.com"
MANAGER_PASSWORD="ChangeMe123!"
MANAGER_NAME="Marc"

# Resend (https://resend.com) — sends the submission notification email with
# the PDF attached. Without these set, submissions still work; the email is
# just skipped.
RESEND_API_KEY=""
EMAIL_FROM="quality-tracker@beldenae.com"

# S3-compatible object storage for photos (AWS S3, Cloudflare R2, MinIO, ...).
# Leave S3_ENDPOINT unset for real AWS S3; set it for R2/MinIO/other providers.
# Without these set, photo upload is disabled but the rest of the app works.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
